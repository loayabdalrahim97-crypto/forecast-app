# ============================================================
# FORECAST — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/forecast?schema=public"

# --- Auth (NextAuth / Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- AI Providers ---
# At least one is required. Model routing config lives in
# src/lib/ai/model-router.ts, not in env vars, so routing can change
# without redeploying secrets.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""

# --- Stripe (added in the Billing phase) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Analytics (added in the Analytics phase) ---
ANALYTICS_WRITE_KEY=""

# --- App ---
NODE_ENV="development"
DEFAULT_LOCALE="en-us"
DEFAULT_CURRENCY="USD"
